{
  "name": "arch-views",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "arch:validate": "npm run build && node dist/cli.js validate",
    "spike:build": "node scripts/spike-build.mjs",
    "spike:serve": "node scripts/spike-serve.mjs",
    "editor:build": "tsx scripts/editor-build.ts",
    "editor:serve": "tsx scripts/editor-serve.ts",
    "arch:build": "npm run build && node dist/cli.js build",
    "editor:screens": "tsx scripts/editor-screens.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cytoscape": "3.30.2",
    "cytoscape-elk": "2.2.0",
    "elkjs": "0.9.3",
    "esbuild": "^0.28.2",
    "fflate": "0.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.20.5",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "bin": {
    "arch-views": "dist/cli.js"
  }
}
